# Server Configuration
NODE_ENV=development
PORT=3001

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=eu_ai_act_audit
DB_USER=postgres
DB_PASSWORD=your_password_here

# JWT Secret (Generate a secure random string)
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRES_IN=7d

# File Upload
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760

# CORS
CORS_ORIGIN=http://localhost:5173

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ===========================================
# DEMO CONFIGURATION
# ===========================================

# Enable/disable demo feature entirely
# Set to 'false' to hide "Audit Tools (Demo)" button
DEMO_ENABLED=true

# Auto-grant demo access immediately after form submission
# Set to 'false' to require manual approval
DEMO_AUTO_GRANT=true

# Demo JWT Secret (separate from main JWT for security)
DEMO_JWT_SECRET=your_demo_jwt_secret_change_this
DEMO_TOKEN_EXPIRY=7d
