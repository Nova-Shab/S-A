# Server Configuration
NODE_ENV=development
PORT=3001

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=eu_ai_act_audit
DB_USER=postgres
DB_PASSWORD=your_password_here

# JWT Secret (Generate a secure random string)
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRES_IN=7d

# File Upload
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760

# CORS
CORS_ORIGIN=http://localhost:5173

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ===========================================
# DEMO CONFIGURATION
# ===========================================

# Enable/disable demo feature entirely
# Set to 'false' to hide "Audit Tools (Demo)" button
DEMO_ENABLED=true

# Auto-grant demo access immediately after form submission
# Set to 'false' to require manual approval
DEMO_AUTO_GRANT=true

# Demo JWT Secret (separate from main JWT for security)
DEMO_JWT_SECRET=your_demo_jwt_secret_change_this
DEMO_TOKEN_EXPIRY=7d

# ===========================================
# SCANNER AI CONFIGURATION
# ===========================================

# OpenAI Configuration for GPT-powered Scanner (Cloud, kostenpflichtig)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
SCANNER_USE_GPT=false

# Ollama Configuration for Local LLM Scanner (kostenlos, lokal)
# 1. Installiere Ollama: https://ollama.com
# 2. Erstelle das Modell: cd backend/ollama && ollama create eu-ai-act -f Modelfile
SCANNER_USE_OLLAMA=true
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=eu-ai-act

# ===========================================
# SCANNER V2 - EVIDENCE-BASED ANALYSIS
# ===========================================

# Enable evidence-based scanner (recommended)
# Set to 'false' to use legacy scanner
SCANNER_USE_EVIDENCE_BASED=true

# Enable debug logging (saves analysis traces)
SCANNER_DEBUG=false

# Save analysis traces to files (for auditing)
SCANNER_SAVE_TRACE=false
SCANNER_TRACE_DIR=./traces
